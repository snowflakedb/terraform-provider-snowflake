func Parse{{ .NameSingular }}Described(rows []{{ .DescribeParse.RowsType }}) ({{ .DescribeParse.DetailsType }}, error) {
	details := {{ .DescribeParse.DetailsType }}{}
	{{- if .DescribeParse.RowsField }}
	details.{{ .DescribeParse.RowsField }} = {{ .DescribeParse.RowsFieldType }}(rows)
	{{- end }}
	{{- range .DescribeParse.Prefixes }}
	var {{ .Var }} []{{ .ElementType }}
	{{- end }}
	for _, row := range rows {
		switch {
		{{- range .DescribeParse.Properties }}
		case row.{{ $.DescribeParse.PropertyField }} == "{{ .Property }}":
			{{- if .Parser }}
			value, err := {{ .Parser }}(row.{{ $.DescribeParse.ValueField }})
			if err != nil {
				return {{ $.DescribeParse.DetailsType }}{}, err
			}
			details.{{ .Field }} = value
			{{- else }}
			details.{{ .Field }} = row.{{ $.DescribeParse.ValueField }}
			{{- end }}
		{{- end }}
		{{- range .DescribeParse.Prefixes }}
		case strings.Contains(row.{{ $.DescribeParse.PropertyField }}, "{{ .Prefix }}"):
			element, err := {{ .ElementParser }}(row.{{ $.DescribeParse.ValueField }})
			if err != nil {
				return {{ $.DescribeParse.DetailsType }}{}, err
			}
			{{ .Var }} = append({{ .Var }}, element)
		{{- end }}
		default:
			{{- if .DescribeParse.IgnoreUnknown }}
			log.Printf("[WARN] unrecognized {{ .DescribeParse.ErrorLabel }} property: %s", row.{{ .DescribeParse.PropertyField }})
			{{- else }}
			return {{ .DescribeParse.DetailsType }}{}, fmt.Errorf("Unrecognized {{ .DescribeParse.ErrorLabel }} property: %s", row.{{ .DescribeParse.PropertyField }})
			{{- end }}
		}
	}
	{{- range .DescribeParse.Prefixes }}
	details.{{ .Field }} = {{ .Var }}
	{{- end }}
	if err := {{ .DescribeParse.ValidateFunc }}(details); err != nil {
		return {{ .DescribeParse.DetailsType }}{}, err
	}
	return details, nil
}
{{- end }}
