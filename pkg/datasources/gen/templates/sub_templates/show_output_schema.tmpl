{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/datasources/gen.DataSourceModel*/ -}}
{{- if .Hooks.ShowOutputSchema.Generate -}}
	map[string]*schema.Schema{
		resources.ShowOutputAttributeName: {
			Type:        schema.TypeList,
			Computed:    true,
			Description: "Holds the output of SHOW {{ .ShowSql }}.",
			Elem: &schema.Resource{
				Schema: schemas.Show{{ .Name }}Schema,
			},
		},
	},
{{ else if .Hooks.ShowOutputSchema.Present -}}
	{{ .Prefix }}ShowOutputSchemaExt,
{{ end -}}
