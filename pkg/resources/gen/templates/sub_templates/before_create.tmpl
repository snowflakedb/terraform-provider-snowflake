{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.BeforeCreate.Generate }}
{{- /* One block per kind of BeforeCreateSteps field. */ -}}
{{- with .BeforeCreateSteps.AdoptExisting }}
	if {{ range $i, $name := .Names }}{{ if $i }} || {{ end }}strings.EqualFold(strings.TrimSpace(d.Get("name").(string)), "{{ $name }}"){{ end }} {
		_, err := meta.(*provider.Context).Client.{{ $.NamePlural }}.ShowByID(ctx, id)
		if err == nil {
			log.Printf("[DEBUG] found %s {{ .ObjectWords }} during creation, updating...", id.Name())
			d.SetId({{ if $.LegacyIdEncoding }}helpers.EncodeSnowflakeID(id){{ else }}helpers.EncodeResourceIdentifier(id){{ end }})
			return Update{{ $.Name }}(ctx, d, meta)
		}
		if !errors.Is(err, sdk.ErrObjectNotFound) {
			return diag.FromErr(err)
		}
	}
{{- end }}

{{ else if .Hooks.BeforeCreate.Present }}
	done, diags := {{ .Prefix }}BeforeCreateExt(ctx, d, meta, id)
	if done {
		return diags
	}

{{ end -}}
