{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.DescribeInSdk.Generate -}}
		{{ .Prefix }}Details, err := meta.(*provider.Context).Client.{{ .NamePlural }}.Describe(ctx, id)
		if err != nil {
			return diag.FromErr(err)
		}
{{ else if .Hooks.DescribeInSdk.Present -}}
{{- if .DescribeFailRead -}}
		{{ .Prefix }}Details, err := {{ .Prefix }}DescribeInSdkExt(ctx, meta, id)
		if err != nil {
			return diag.FromErr(err)
		}
{{- else }}
		// Describe is best-effort: log + skip Set, do not fail Read. {{ if .DescribeUsesShowId }}Uses SHOW object's id.{{ else }}Uses parsed id.{{ end }}
		{{ .Prefix }}Details, describeErr := {{ .Prefix }}DescribeInSdkExt(ctx, meta, {{ if .DescribeUsesShowId }}{{ .Prefix }}.ID(){{ else }}id{{ end }})
{{- end }}
{{ end -}}
