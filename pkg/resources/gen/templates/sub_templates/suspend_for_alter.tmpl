{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.SuspendForAlter.Generate }}
{{- if .SuspendForAlter.NeededExt }}
	suspension, err := SuspendForAlterIf(ctx, d, {{ .Prefix }}SuspendForAlterNeededExt(d), meta.(*provider.Context).Client.{{ .NamePlural }}.SuspendIfStarted, id{{ range .SuspendForAlter.When }}, "{{ . }}"{{ end }})
{{- else }}
	suspension, err := SuspendForAlter(ctx, d, meta.(*provider.Context).Client.{{ .NamePlural }}.SuspendIfStarted, id{{ range .SuspendForAlter.When }}, "{{ . }}"{{ end }})
{{- end }}
	defer suspension.CleanUp(ctx, d, &diags)
	if err != nil {
		return diag.FromErr(err)
	}

{{ end -}}
