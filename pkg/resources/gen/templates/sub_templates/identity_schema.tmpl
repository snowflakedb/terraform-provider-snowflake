{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
{{- if .Hooks.IdentitySchema.Generate -}}
{{- $words := CamelToWords .Name -}}
{{- $unique := "" -}}
{{- if eq .IdType "AccountObjectIdentifier" -}}
{{- $unique = "account" -}}
{{- else if eq .IdType "DatabaseObjectIdentifier" -}}
{{- $unique = printf "database in which the %s is created" $words -}}
{{- else if eq .IdType "SchemaObjectIdentifier" -}}
{{- $unique = printf "schema in which the %s is created" $words -}}
{{- else -}}
{{- Unimplemented (printf "object %s: unsupported IdType %s" .Name .IdType) -}}
{{- end -}}
{{- $nameText := printf "Specifies the identifier for the %s; must be unique for the %s." $words $unique -}}
{{- if .AdditionalIdentityNameDescription -}}
{{- $nameText = printf "%s %s" $nameText .AdditionalIdentityNameDescription -}}
{{- end -}}
{{- $databaseText := printf "The database in which to create the %s." $words -}}
{{- $schemaText := printf "The schema in which to create the %s." $words -}}
	map[string]*tfschema.Schema{
		"name": {
			Type:     tfschema.TypeString,
			Required: true,
{{- if .IdentityNameForceNew }}
			ForceNew: true,
{{- end }}
			Description: blocklistedCharactersFieldDescription({{ Quote $nameText }}),
			DiffSuppressFunc: suppressIdentifierQuoting,
		},
{{- if or (eq .IdType "DatabaseObjectIdentifier") (eq .IdType "SchemaObjectIdentifier") }}
		"database": {
			Type:             tfschema.TypeString,
			Required:         true,
{{- if .IdentityHierarchyForceNew }}
			ForceNew:         true,
{{- end }}
			Description: blocklistedCharactersFieldDescription({{ Quote $databaseText }}),
			DiffSuppressFunc: suppressIdentifierQuoting,
		},
{{- end }}
{{- if eq .IdType "SchemaObjectIdentifier" }}
		"schema": {
			Type:             tfschema.TypeString,
			Required:         true,
{{- if .IdentityHierarchyForceNew }}
			ForceNew:         true,
{{- end }}
			Description: blocklistedCharactersFieldDescription({{ Quote $schemaText }}),
			DiffSuppressFunc: suppressIdentifierQuoting,
		},
{{- end }}
	},
{{ else if .Hooks.IdentitySchema.Present -}}
	{{ .Prefix }}IdentitySchemaExt,
{{ end -}}
