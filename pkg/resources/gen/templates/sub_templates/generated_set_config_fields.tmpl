{{- /*gotype: github.com/Snowflake-Labs/terraform-provider-snowflake/pkg/resources/gen.ResourceModel*/ -}}
func {{ .Prefix }}SetConfigFields(d *tfschema.ResourceData, obj *sdk.{{ .ShowObjectName }}) error {
{{- if .ConfigFieldSets }}
	return errors.Join(
{{- range .ConfigFieldSets }}
		d.Set({{ printf "%q" .Name }}, {{ .Expr }}),
{{- end }}
	)
{{- else }}
	return nil
{{- end }}
}
